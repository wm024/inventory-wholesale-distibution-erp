<odoo>
    <record id="module_category_adn_approval" model="ir.module.category">
        <field name="name">ADN Approvals</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_approval_user" model="res.groups">
        <field name="name">Approval User</field>
        <field name="category_id" ref="module_category_adn_approval"/>
    </record>
    <record id="group_approval_manager" model="res.groups">
        <field name="name">Approval Manager</field>
        <field name="category_id" ref="module_category_adn_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_user'))]"/>
    </record>
    <record id="group_approval_policy_admin" model="res.groups">
        <field name="name">Approval Policy Administrator</field>
        <field name="category_id" ref="module_category_adn_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_approval_manager'))]"/>
    </record>

    <!-- Requesters see their own requests; approvers see requests routed to one of their groups. -->
    <record id="rule_approval_request_company" model="ir.rule">
        <field name="name">Approval requests: requester or assigned approver</field>
        <field name="model_id" ref="model_adn_approval_request"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('requester_id', '=', user.id), ('approver_group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
    </record>
    <record id="rule_approval_request_manager_company" model="ir.rule">
        <field name="name">Approval managers: all requests in allowed companies</field>
        <field name="model_id" ref="model_adn_approval_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
    </record>

    <record id="rule_approval_policy_company" model="ir.rule">
        <field name="name">Approval policies: global or allowed companies</field>
        <field name="model_id" ref="model_adn_approval_policy"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_user')), (4, ref('group_approval_manager'))]"/>
    </record>

    <record id="rule_approval_step_company" model="ir.rule">
        <field name="name">Approval steps: requester or assigned approver</field>
        <field name="model_id" ref="model_adn_approval_step"/>
        <field name="domain_force">['&amp;', ('request_id.company_id', 'in', company_ids), '|', ('request_id.requester_id', '=', user.id), ('approver_group_id', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
    </record>
    <record id="rule_approval_step_manager_company" model="ir.rule">
        <field name="name">Approval managers: all steps in allowed companies</field>
        <field name="model_id" ref="model_adn_approval_step"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
    </record>

    <record id="rule_approval_item_company" model="ir.rule">
        <field name="name">Approval items: requester or assigned approver</field>
        <field name="model_id" ref="model_adn_approval_item"/>
        <field name="domain_force">['&amp;', ('request_id.company_id', 'in', company_ids), '|', ('request_id.requester_id', '=', user.id), ('request_id.approver_group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
    </record>
    <record id="rule_approval_item_manager_company" model="ir.rule">
        <field name="name">Approval managers: all items in allowed companies</field>
        <field name="model_id" ref="model_adn_approval_item"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
    </record>

    <record id="rule_approval_event_company" model="ir.rule">
        <field name="name">Approval events: requester or assigned approver</field>
        <field name="model_id" ref="model_adn_approval_event"/>
        <field name="domain_force">['&amp;', ('request_id.company_id', 'in', company_ids), '|', ('request_id.requester_id', '=', user.id), ('request_id.approver_group_ids', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_user'))]"/>
    </record>
    <record id="rule_approval_event_manager_company" model="ir.rule">
        <field name="name">Approval managers: all events in allowed companies</field>
        <field name="model_id" ref="model_adn_approval_event"/>
        <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
    </record>
</odoo>
