<odoo>
    <record id="module_category_credit_control" model="ir.module.category">
        <field name="name">ADN Credit Control</field>
        <field name="sequence">38</field>
    </record>
    <record id="privilege_credit_control" model="res.groups.privilege">
        <field name="name">ADN Credit Control</field>
        <field name="category_id" ref="module_category_credit_control"/>
        <field name="sequence">38</field>
    </record>
    <record id="group_credit_requester" model="res.groups">
        <field name="name">Credit Exception Requester</field>
        <field name="privilege_id" ref="privilege_credit_control"/>
        <field name="implied_ids" eval="[(4, ref('adn_approval_core.group_approval_user'))]"/>
    </record>
    <record id="group_credit_manager" model="res.groups">
        <field name="name">Finance Credit Manager</field>
        <field name="privilege_id" ref="privilege_credit_control"/>
        <field name="implied_ids" eval="[(4, ref('adn_approval_core.group_approval_user'))]"/>
    </record>
    <record id="group_finance_manager_credit_approver" model="res.groups">
        <field name="name">Finance Manager — Credit Approver</field>
        <field name="privilege_id" ref="privilege_credit_control"/>
        <field name="implied_ids" eval="[(4, ref('adn_approval_core.group_approval_user'))]"/>
    </record>
    <record id="group_managing_director_credit_approver" model="res.groups">
        <field name="name">Managing Director — Credit Approver</field>
        <field name="privilege_id" ref="privilege_credit_control"/>
        <field name="implied_ids" eval="[(4, ref('adn_approval_core.group_approval_user'))]"/>
    </record>
    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_credit_requester'))]"/>
    </record>

    <record id="rule_partner_credit_company" model="ir.rule">
        <field name="name">Customer credit profiles: allowed companies</field>
        <field name="model_id" ref="model_adn_partner_credit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_credit_manager')), (4, ref('group_finance_manager_credit_approver')), (4, ref('group_managing_director_credit_approver'))]"/>
    </record>
    <record id="rule_credit_evaluation_company" model="ir.rule">
        <field name="name">Credit evaluations: allowed companies</field>
        <field name="model_id" ref="model_adn_credit_evaluation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_credit_manager')), (4, ref('group_finance_manager_credit_approver')), (4, ref('group_managing_director_credit_approver'))]"/>
    </record>

    <record id="rule_credit_approver_sale_order_company" model="ir.rule">
        <field name="name">Credit approvers: sales orders in allowed companies</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_credit_manager')), (4, ref('group_finance_manager_credit_approver')), (4, ref('group_managing_director_credit_approver'))]"/>
    </record>
    <record id="rule_credit_approver_sale_order_line_company" model="ir.rule">
        <field name="name">Credit approvers: sales order lines in allowed companies</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_credit_manager')), (4, ref('group_finance_manager_credit_approver')), (4, ref('group_managing_director_credit_approver'))]"/>
    </record>
</odoo>
