<odoo>
    <record id="view_partner_form_credit_control" model="ir.ui.view">
        <field name="name">res.partner.form.credit.control</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="commercial_partner_id" invisible="1"/>
                <group string="Customer Credit Profiles" invisible="commercial_partner_id != id" groups="adn_credit_control.group_credit_manager,adn_credit_control.group_finance_manager_credit_approver,adn_credit_control.group_managing_director_credit_approver">
                    <field name="adn_credit_profile_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="company_id"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="credit_limit" readonly="1"/>
                            <field name="status" readonly="1"/>
                            <field name="finance_blocked"/>
                            <field name="review_date"/>
                            <field name="proposed_credit_limit"/>
                            <field name="proposed_limit_reason"/>
                            <field name="credit_limit_approval_request_id" readonly="1" optional="hide"/>
                            <field name="credit_limit_approved_by_id" readonly="1"/>
                            <button name="action_submit_credit_limit_change" type="object" icon="fa-paper-plane" title="Submit Credit Limit Change" groups="adn_credit_control.group_credit_manager"/>
                            <button name="action_apply_approved_credit_limit" type="object" icon="fa-check" title="Apply Approved Credit Limit" groups="adn_credit_control.group_credit_manager"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
