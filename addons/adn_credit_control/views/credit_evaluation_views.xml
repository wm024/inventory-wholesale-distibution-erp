<odoo>
    <record id="view_credit_evaluation_list" model="ir.ui.view">
        <field name="name">adn.credit.evaluation.list</field>
        <field name="model">adn.credit.evaluation</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="evaluated_at"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="currency_id"/>
                <field name="sale_order_id"/>
                <field name="credit_limit"/>
                <field name="posted_ar_amount"/>
                <field name="uninvoiced_order_amount"/>
                <field name="overdue_amount"/>
                <field name="exposure_amount"/>
                <field name="available_credit"/>
                <field name="utilization_percentage"/>
                <field name="decision"/>
                <field name="approval_request_id" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_credit_evaluation_form" model="ir.ui.view">
        <field name="name">adn.credit.evaluation.form</field>
        <field name="model">adn.credit.evaluation</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="evaluated_at"/>
                        <field name="partner_id"/>
                        <field name="company_id"/>
                        <field name="sale_order_id"/>
                        <field name="decision"/>
                    </group>
                    <group string="Exposure Components">
                        <field name="currency_id" invisible="1"/>
                        <field name="credit_limit"/>
                        <field name="posted_ar_amount"/>
                        <field name="uninvoiced_order_amount"/>
                        <field name="overdue_amount"/>
                        <field name="overdue_1_30_amount"/>
                        <field name="overdue_over_30_amount"/>
                        <field name="exposure_amount"/>
                        <field name="available_credit"/>
                        <field name="utilization_percentage"/>
                    </group>
                    <group string="Audit">
                        <field name="hold_reasons"/>
                        <field name="source_fingerprint"/>
                        <field name="source_detail"/>
                        <field name="approval_request_id"/>
                        <field name="released_at"/>
                        <field name="released_by_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_credit_evaluations" model="ir.actions.act_window">
        <field name="name">Credit Evaluations</field>
        <field name="res_model">adn.credit.evaluation</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_credit_control_root" name="Credit Control" parent="account.menu_finance" sequence="85" groups="adn_credit_control.group_credit_manager,adn_credit_control.group_finance_manager_credit_approver,adn_credit_control.group_managing_director_credit_approver"/>
    <menuitem id="menu_credit_evaluations" name="Credit Evaluations" parent="menu_credit_control_root" action="action_credit_evaluations" sequence="10" groups="adn_credit_control.group_credit_manager,adn_credit_control.group_finance_manager_credit_approver,adn_credit_control.group_managing_director_credit_approver"/>
</odoo>
