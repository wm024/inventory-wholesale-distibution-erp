<odoo>
    <record id="view_credit_exception_reason_form" model="ir.ui.view">
        <field name="name">adn.credit.exception.reason.form</field>
        <field name="model">adn.credit.exception.reason</field>
        <field name="arch" type="xml">
            <form string="Submit Credit Exception">
                <group>
                    <field name="sale_order_id"/>
                    <field name="reason" placeholder="Explain the commercial reason and mitigation..."/>
                </group>
                <footer>
                    <button name="action_submit" type="object" string="Submit for Approval" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
