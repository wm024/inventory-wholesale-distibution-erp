<odoo>
    <record id="view_adn_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">adn.approval.reject.wizard.form</field>
        <field name="model">adn.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Approval Request">
                <group><field name="request_id"/><field name="reason" placeholder="Explain why this request is rejected..."/></group>
                <footer><button name="action_confirm" type="object" string="Confirm Rejection" class="btn-primary"/><button string="Discard" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
    <record id="action_adn_approval_reject_wizard" model="ir.actions.act_window">
        <field name="name">Reject Approval Request</field><field name="res_model">adn.approval.reject.wizard</field>
        <field name="view_mode">form</field><field name="view_id" ref="view_adn_approval_reject_wizard_form"/><field name="target">new</field>
        <field name="context">{'default_request_id': active_id}</field>
    </record>
</odoo>
